  "typography": {
    "$description": "Typography system based on Urbanist",
    "font-family": {
      "base": {
        "$type": "fontFamily",
        "$value": "Urbanist, sans-serif",
        "$description": "Primary typeface for all text"
      }
    },
    "font-weight": {
      "normal": {
        "$type": "fontWeight",
        "$value": 400
      },
      "medium": {
        "$type": "fontWeight",
        "$value": 500
      },
      "bold": {
        "$type": "fontWeight",
        "$value": 700
      }
    },
    "font-size": {
      "xs": {
        "$type": "dimension",
        "$value": "12px"
      },
      "sm": {
